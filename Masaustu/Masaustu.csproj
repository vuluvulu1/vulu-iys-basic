<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>logo.ico</ApplicationIcon>

    <!-- Programın bağlandığı API. Exe'nin içine yazılır (bkz. Api.cs);
         Paketleyici her işletme için bunu o işletmenin Render adresiyle değiştirir. -->
    <ApiAdresi Condition="'$(ApiAdresi)' == ''">http://localhost:5050/</ApiAdresi>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ApiAdresi" Value="$(ApiAdresi)" />
    <!-- Logo exe'nin içine gömülür, programın yanında ayrı dosya gerekmez (bkz. Tema.cs). -->
    <EmbeddedResource Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modeller\Modeller.csproj" />
  </ItemGroup>

</Project>
